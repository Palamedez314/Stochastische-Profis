% ACHTUNG!
% Es kann zu Problemen kommen, wenn ihr ein \usepackage zweimal ausführt.
% Dementsprechend ist der Befehl \RequirePackage sinnvoller, 
% da das Paket nur geladen wird, wenn es noch nicht geladen wurde.
%
%
\ProvidesPackage{mathe_definition}

% Vorspann für verschiedene Optionen
% Option exercise speziell für Übungsblätter
\newif\if@exercise
\@exercisefalse
% Option float left equation
\newif\if@fleqn
\@fleqnfalse
% Option zur Einbindung von listings
\newif\if@listings
\@listingsfalse
%
% Verarbeitung der Optionen
\DeclareOption{exercise}{\@exercisetrue}
\DeclareOption{fleqn}{\@fleqntrue}
\DeclareOption{listings}{\@listingstrue}
\ProcessOptions\relax



% Laden der Pakete:
% Umlaute und so
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
% Deutsches Sprachpaket
\RequirePackage[ngerman]{babel}
% Für Zeichnungen
% Für Zeichnungen
\RequirePackage{rotating,tikz}
\usetikzlibrary{backgrounds,decorations,arrows.meta,positioning,shapes,arrows,automata,matrix,trees,fit}
% Plotten mit pgf
\RequirePackage{pgfplots}
% Pakete für Mathematik
\RequirePackage{amsmath, amsfonts, amssymb, amsthm, mathtools, ifthen, mathrsfs}
% Pakete für den Header/Foot und Seitennummerierung
\RequirePackage{fancyhdr, lastpage}
% Grafiken, Farben	
\RequirePackage{graphicx, xcolor}
% Mehrere Spalten/Zeilen auf einer Seite
\RequirePackage{multicol, multirow}
% Externen Quellcode einbinden
\if@listings
%	Das Paket listings wird innerhalb des listings_definitions geladen, 
%	es muss hier nicht geladen werden.
	\RequirePackage{listings_definitions}
\fi
% Algorithmen
\RequirePackage[german]{algorithm2e}
% Macht mit \MyAuthor \MyDate usw. Titelinfos auch nach dem Titel nutzbar
\RequirePackage{authoraftertitle}
% Um externe Bilder wie Tikzpicture zu implementieren:
\RequirePackage{standalone}
% Links anklickbar machen
\RequirePackage{hyperref}
% Festlegen der Geometrie des Blattes
\RequirePackage{geometry}
% Definition der eigentlichen Geometrie
\geometry{a4paper, vscale=0.93, hscale=0.83, includeheadfoot, headheight=5ex, headsep=5ex}
%
%
%
%			-------------
% Jeglichen Einschub nach Absätzen vermeiden
\parindent 0em
% Einschub in Matheumgebungen ändern (nur bei aktiven fleqn)
\if@fleqn
	\mathindent 3mm
\fi
% Zähler für Blattnummer
\newcounter{blnr}
%
%
%
%			-------------
% Umgebung für Aufgaben
\newenvironment{exercise}
{
% Ändere die Aufzählungen:
% Aufzählung 1. Stufe
\renewcommand{\theenumi}{{\bfseries \arabic{blnr}.\arabic{enumi}}}
\renewcommand{\labelenumi}{\theenumi\bfseries.}
% Aufzählung 2. Stufe
\renewcommand{\theenumii}{{\bfseries \alph{enumii})}}
\renewcommand{\labelenumii}{\theenumii}
% Aufzählung 3. Stufe
\renewcommand{\theenumiii}{{$(\roman{enumiii})$}}
\renewcommand{\labelenumiii}{\theenumiii}
% 
\begin{enumerate}}
% Nach der Umgebung
{\end{enumerate}}
%
%
%
%
% Definiere den Pagestyle für Aufgabenblätter
\fancypagestyle{exercisepages}{
	% Header links
	\lhead{\MyAuthor\\ \MyMatriculation}
	% Abkürzung für \fancyhead[L]{...}
	% \fancyhead[LO]{...} O = odd, E = even
	%
	% Header Mitte
	\chead{\MyModule\\ Blatt \arabic{blnr}}
	% Header rechts
	\rhead{\MyDate\\ Seite \thepage{} von \pageref{LastPage}}
	% Fußzeile
	% Seitenzahl aus der Fußzeile entfernen
	\cfoot{}
}
%
%
% Auswählen des pagestyle
\if@exercise
	\pagestyle{exercisepages}
\else
	\pagestyle{fancy}
\fi
